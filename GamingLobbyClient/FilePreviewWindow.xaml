<Window x:Class="GamingLobbyClient.FilePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Preview" Height="450" Width="600">
    <Grid Margin="10">
        <Image x:Name="PreviewImage" Stretch="Uniform"/>
        <ScrollViewer x:Name="PreviewScrollViewer" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="PreviewTextBlock" TextWrapping="Wrap"/>
        </ScrollViewer>
    </Grid>
</Window>