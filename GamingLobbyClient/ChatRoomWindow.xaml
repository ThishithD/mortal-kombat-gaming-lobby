<Window x:Class="GamingLobbyClient.ChatRoomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chat Room"
        Height="500" Width="850"
        Loaded="Window_Loaded" Closing="Window_Closing"
        Background="Black">

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/Images/ChatRoom.png" Stretch="UniformToFill"/>
        </Grid.Background>

        <Rectangle Fill="#AA000000"/>

        <Grid Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="240" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox x:Name="MessagesListBox"
                         Grid.Row="0"
                         Margin="0,0,10,10"
                         HorizontalContentAlignment="Stretch"
                         Background="#66222222"
                         Foreground="White"
                         BorderBrush="White"
                         BorderThickness="2"
                         FontSize="14"
                         FontFamily="pack://application:,,,/Fonts/#earthrealm">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock FontWeight="Bold"
                                           Foreground="Gold"
                                           Text="{Binding Username, StringFormat='{}{0}:'}"
                                           Margin="0,0,5,0"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Message}"
                                           Foreground="White"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="MessageTextBox"
                             Grid.Column="0"
                             Margin="0,0,10,0"
                             VerticalContentAlignment="Center"
                             Background="#222"
                             Foreground="White"
                             BorderBrush="White"
                             BorderThickness="2"
                             FontSize="14"
                             KeyDown="MessageTextBox_KeyDown"/>

                    <Border Grid.Column="1"
                            CornerRadius="10"
                            Background="Black"
                            BorderBrush="White"
                            BorderThickness="2">
                        <Button x:Name="SendButton"
                                Content="SEND"
                                FontFamily="pack://application:,,,/Fonts/#earthrealm"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="White"
                                FontWeight="Bold"
                                Padding="15,6"
                                Cursor="Hand"
                                Click="SendButton_Click"
                                FontSize="17">
                            <Button.Effect>
                                <DropShadowEffect Color="Black"
                                                  BlurRadius="12"
                                                  ShadowDepth="0"/>
                            </Button.Effect>
                        </Button>
                    </Border>
                </Grid>
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Content="Players in Room"
                       FontFamily="pack://application:,,,/Fonts/#earthrealm"
                       FontSize="18"
                       Foreground="White"/>
                <ListBox x:Name="PlayersListBox"
                         Grid.Row="1"
                         Margin="0,5,0,10"
                         Background="#66222222"
                         Foreground="White"
                         BorderBrush="White"
                         BorderThickness="2"
                         FontSize="14"
                         FontFamily="pack://application:,,,/Fonts/#earthrealm">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Margin="2"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Label Content="Shared Files"
                       Grid.Row="2"
                       FontFamily="pack://application:,,,/Fonts/#earthrealm"
                       FontSize="18"
                       Foreground="White"/>
                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border CornerRadius="10"
                            Background="Black"
                            BorderBrush="White"
                            BorderThickness="2"
                            Margin="0,5,0,5">
                        <Button x:Name="ShareFileButton"
                                Content="SHARE FILE"
                                FontSize="18"
                                FontFamily="pack://application:,,,/Fonts/#earthrealm"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="White"
                                FontWeight="Bold"
                                Padding="12,6"
                                Cursor="Hand"
                                Click="ShareFileButton_Click"/>
                    </Border>

                    <ListBox x:Name="SharedFilesListBox"
                             Grid.Row="1"
                             Background="#66222222"
                             Foreground="White"
                             BorderBrush="White"
                             BorderThickness="2">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2">
                                    <TextBlock>
                                        <Hyperlink Click="FileLink_Click"
                                                   CommandParameter="{Binding}">
                                            <Run Text="{Binding FileName}"/>
                                        </Hyperlink>
                                        <Run Text=" (Shared by: " FontSize="10" Foreground="Gray"/>
                                        <Run Text="{Binding SharedByUsername}" FontSize="10" Foreground="Gray"/>
                                        <Run Text=")" FontSize="10" Foreground="Gray"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <Border Grid.Row="4"
                        CornerRadius="12"
                        Background="Black"
                        BorderBrush="White"
                        BorderThickness="2"
                        Margin="0,10,0,0">
                    <Button x:Name="LeaveRoomButton"
                            Content="LEAVE ROOM"
                            FontFamily="pack://application:,,,/Fonts/#earthrealm"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="White"
                            FontSize="18"
                            FontWeight="Bold"
                            Padding="12,6"
                            Cursor="Hand"
                            Click="LeaveRoomButton_Click">
                        <Button.Effect>
                            <DropShadowEffect Color="Black"
                                              BlurRadius="15"
                                              ShadowDepth="0"/>
                        </Button.Effect>
                    </Button>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
