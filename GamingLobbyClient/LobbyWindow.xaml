<Window x:Class="GamingLobbyClient.LobbyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Lobby" Height="500" Width="800"
        Background="Black"
        Loaded="Window_Loaded" Closing="Window_Closing">

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/Images/Lobby.png" Stretch="Fill"/>
        </Grid.Background>

        <Rectangle Fill="#44000000"/>

        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,15,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Content="Available Chat Rooms" 
                       FontFamily="pack://application:,,,/Fonts/#earthrealm"
                       FontSize="20"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

                <ListBox x:Name="RoomsListBox" 
                         Grid.Row="1" 
                         Margin="0,5,0,0"
                         Background="#66222222"
                         Foreground="White"
                         BorderBrush="White"
                         BorderThickness="2"
                         FontSize="14"
                         FontFamily="pack://application:,,,/Fonts/#earthrealm"/>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,15,0,0">
                    <TextBox x:Name="NewRoomNameTextBox" 
                             Width="200" Height="30"
                             Background="#66222222"
                             Foreground="White"
                             BorderBrush="White"    
                             BorderThickness="2"
                             VerticalContentAlignment="Center"
                             FontSize="14"/>

                    <Border CornerRadius="12" 
                            Background="Black" 
                            BorderBrush="White" 
                            BorderThickness="2" 
                            Margin="10,0,0,0"
                            Cursor="Hand"
                            MouseLeftButtonUp="CreateRoomButton_Click">
                        <TextBlock Text="Create Room" 
                                   Foreground="White"
                                   FontFamily="pack://application:,,,/Fonts/#earthrealm"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Padding="12,6"/>
                    </Border>

                    <Border CornerRadius="12" 
                            Background="Black" 
                            BorderBrush="White" 
                            BorderThickness="2" 
                            Margin="10,0,0,0"
                            Cursor="Hand"
                            MouseLeftButtonUp="JoinRoomButton_Click">
                        <TextBlock Text="Join Selected Room" 
                                   Foreground="White"
                                   FontFamily="pack://application:,,,/Fonts/#earthrealm"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Padding="12,6"/>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Content="Players Online" 
                       FontFamily="pack://application:,,,/Fonts/#earthrealm"
                       FontSize="20"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

                <ListBox x:Name="PlayersListBox" 
                         Grid.Row="1" 
                         Margin="0,5,0,0"
                         Background="#66222222"
                         Foreground="White"
                         BorderBrush="White"
                         BorderThickness="2"
                         FontSize="14"
                         FontFamily="pack://application:,,,/Fonts/#earthrealm"
                         MouseDoubleClick="PlayersListBox_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="14"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="2"
                        CornerRadius="10" 
                        Background="Black" 
                        BorderBrush="White" 
                        BorderThickness="2" 
                        Margin="0,15,0,0"
                        Cursor="Hand"
                        MouseLeftButtonUp="LogoutButton_Click">
                    <TextBlock Text="LOGOUT" 
                               Foreground="White"
                               FontFamily="pack://application:,,,/Fonts/#earthrealm"
                               FontSize="16"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Padding="12,6"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
