<Window x:Class="GamingLobbyClient.PrivateChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Private Chat" Height="400" Width="350"
        Background="Black"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/Images/Private chat.png" Stretch="UniformToFill"/>
        </Grid.Background>

        <Rectangle Fill="#44000000"/>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ListBox x:Name="MessagesListBox" 
                     Grid.Row="0" 
                     Margin="0,0,0,10"
                     Background="#66222222"
                     Foreground="White"
                     BorderBrush="White"
                     BorderThickness="2"
                     FontSize="14"
                     FontFamily="pack://application:,,,/Fonts/#earthrealm"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock FontWeight="Bold" 
                                       Text="{Binding Username, StringFormat={}{0}:}" 
                                       Margin="0,0,5,0"
                                       Foreground="Gold"/>

                            <TextBlock Grid.Column="1" 
                                       Text="{Binding Message}" 
                                       TextWrapping="Wrap"
                                       Foreground="White"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="MessageTextBox" 
                         Grid.Column="0" 
                         Margin="0,0,10,0"
                         Background="#222"
                         Foreground="White"
                         BorderBrush="White"
                         BorderThickness="2"
                         VerticalContentAlignment="Center"
                         FontSize="14"
                         FontFamily="earthrealm"
                         KeyDown="MessageTextBox_KeyDown"/>

                <Border Grid.Column="1"
                        CornerRadius="10"
                        Background="Black"
                        BorderBrush="White"
                        BorderThickness="2"
                        Cursor="Hand"
                        MouseLeftButtonUp="SendButton_Click">
                    <TextBlock Text="Send"
                               Foreground="White"
                               FontFamily="pack://application:,,,/Fonts/#earthrealm"
                               FontSize="14"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Padding="12,6"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
