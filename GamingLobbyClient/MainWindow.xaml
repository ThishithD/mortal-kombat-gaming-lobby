<Window x:Class="GamingLobbyClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GamingLobbyClient"
        mc:Ignorable="d"
        Title="Mortal Kombat Login"
        Height="500" Width="850"
        Background="Black">

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/Images/Login.jpg" Stretch="Fill"/>
        </Grid.Background>

        <Rectangle Fill="#AA000000"/>

        <TextBlock Text="MORTAL KOMBAT"
               FontFamily="pack://application:,,,/Fonts/#earthrealm"
               FontSize="40"
               Foreground="White"
               HorizontalAlignment="Center"
               VerticalAlignment="Top"
               Margin="0,40,0,0"/>

        <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="300"
                Margin="0,200,0,0">

            <Label Content="Enter Username:"
               FontFamily="pack://application:,,,/Fonts/#earthrealm"    
               Foreground="White"
               FontWeight="Bold"
               FontSize="20"
               HorizontalAlignment="Center"/>

            <TextBox x:Name="UsernameTextBox"
                 Width="250"
                 Height="30"
                 Margin="0,5,0,20"
                 Background="#222"
                 Foreground="White"
                 BorderBrush="White"
                 BorderThickness="2"
                 VerticalContentAlignment="Center"
                 FontSize="14"/>

            <Border CornerRadius="20"
                Background="Black"
                BorderBrush="White"
                BorderThickness="2"
                Width="150"
                Height="40"
                Margin="0,10,0,0">

                <Button x:Name="LoginButton"
                    Content="LOGIN"
                    FontFamily="pack://application:,,,/Fonts/#earthrealm"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="White"
                    FontSize="25"
                    FontWeight="Bold"
                    Cursor="Hand"
                    Click="LoginButton_Click">
                    <Button.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="0"/>
                    </Button.Effect>
                </Button>
            </Border>

        </StackPanel>
    </Grid>

</Window>
